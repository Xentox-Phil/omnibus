# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit it.

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"

# Better Auth — base URL the app is served from
BETTER_AUTH_URL=http://localhost:3000
# Better Auth — generate with: npx -y @better-auth/cli secret
BETTER_AUTH_SECRET=

# Mapbox access token — create at https://account.mapbox.com/access-tokens/
# Default public scopes only (STYLES:TILES, STYLES:READ, FONTS:READ, DATASETS:READ, VISION:READ).
# No secret scopes, no URL restrictions needed for dev.
VITE_MAPBOX_TOKEN=

# Omnibus demand API (FastAPI) base URL. Run from ../backend:
#   uv run uvicorn app.main:app --port 8000
VITE_API_URL=http://localhost:8000
